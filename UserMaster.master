       <style>


            .logo-text {
    font-size: 24px;
    font-weight: 700;
    line-height: 1;          /* IMPORTANT */
    display: flex;
    align-items: center;
}

.logo-food {
    color: rgb(203.15, 79.9, 36.55);
}

.logo-store {
    color: #000;
}

.footer-logo-text {
    font-size: 22px;                       /* footer me thoda smaller */
    font-weight: 700;
    line-height: 1;
}

.footer-logo-food {
    color: rgb(203.15, 79.9, 36.55);
}

.footer-logo-store {
    color: #fff;          /* footer dark bg hoga to white best */
}

@media (min-width: 425px) and (max-width: 503px) {
    #topnav .container {
        display: flex !important;
        align-items: center !important;
        /* Ise center ya flex-start kar sakte hain agar gap bilkul khatam karna ho */
        justify-content: flex-start !important; 
        flex-wrap: nowrap !important;
        padding: 5px 10px !important;
    }

    /* Logo (Order 1) */
    .logo { 
        order: 1; 
        flex-shrink: 0; 
        margin-right: 10px !important; /* Logo ke baad thoda gap */
    }

    /* Location (Order 2) */
    .menu-location { 
        order: 2; 
        flex-shrink: 0; 
        margin-right: 8px !important; /* Location aur Search ke beech ka gap yahan se control hoga */
    }
    
    /* Buttons Group (Order 3) */
    .buy-button {
        order: 3;
        display: flex !important;
        align-items: center !important;
        gap: 4px !important; 
        /* IMPORTANT: margin-left: auto ko hata diya taaki gap khatam ho jaye */
        margin-left: 0 !important; 
        margin-right: 8px !important;
        padding: 0;
        list-style: none;
    }

    /* Toggle/Hamburger (Order 4) */
    .menu-extras {
        order: 4;
        margin-left: auto !important; /* Toggle ko sabse last (right corner) mein rakhne ke liye */
        flex-shrink: 0;
    }

    /* Baaki settings same rahengi */
    .logo-text { font-size: 19px !important; }
    .btn-sm { padding: 4px 6px !important; font-size: 11px !important; }
    .buy-button a[href*="register.aspx"] { font-size: 0 !important; }
    .buy-button a[href*="register.aspx"]::before { content: "Partner"; font-size: 11px !important; }
    .menu-location .ms-1 { display: none !important; }
}

@media (min-width: 576px) and (max-width: 768px) {
    /* Container ko flex banayein taaki elements move kar sakein */
    #topnav .container {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-wrap: nowrap !important;
        padding: 10px 15px;
    }

    /* Sabse pehle Logo (Order 1) */
    .logo {
        order: 1;
        flex-shrink: 0;
    }

    /* Beach mein Location (Order 2) */
    .menu-location {
        order: 2;
        margin-left: 10px;
    }

    /* Buttons (Search, Partner, Login) (Order 3) */
    .buy-button {
        order: 3;
        display: flex !important;
        align-items: center;
        gap: 8px;
        margin-left: auto !important; /* Isse buttons right side push ho jayenge */
        margin-right: 10px !important;
        padding: 0;
        list-style: none;
    }

    /* Toggle/Hamburger (Order 4 - Sabse Last) */
    .menu-extras {
        order: 4;
        position: relative !important;
        margin: 0 !important;
        display: block !important;
    }

    /* Button sizes ko control karein taaki ek line mein fit ho jayein */
    .btn-sm {
        padding: 5px 10px !important;
        font-size: 12px !important;
        white-space: nowrap;
    }

    /* Mobile par "Select Location" text hide karke sirf icon dikhayein */
    .menu-location .ms-1 {
        display: none !important;
    }
}

@media (min-width: 991px) and (max-width: 1200px) {
    /* Location label ka text hide karein */
    .menu-location span.ms-1 {
        display: none !important;
    }

    /* Location icon ke saath jo gap hai use reset karein */
    .menu-location .align-items-center {
        gap: 0 !important;
    }
}

        </style>

