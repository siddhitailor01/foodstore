            <script src="assets/js/app.js"></script>

            <script>
                // --- NEW FUNCTION: Select City and Keep Search Term ---
                function selectCity(cityId, cityName) {
                    // 1. Get current search term if available (e.g. 'pizza')
                    var searchBox = document.getElementById('<%= txtGlobalSearch.ClientID %>');
                    var searchTerm = "";
                    if (searchBox) {
                        searchTerm = searchBox.value.trim();
                    }

                    // 2. Build Base URL for Restaurants page
                    var url = "Restaurants.aspx?cityid=" + encodeURIComponent(cityId) + "&cityname=" + encodeURIComponent(cityName);

                    // 3. Append search term if it exists
                    if (searchTerm !== "") {
                        url += "&q=" + encodeURIComponent(searchTerm);
                    }

                    // 4. Redirect
                    window.location.href = url;
                }

                // --- EXISTING: Filter Cities in Modal ---
                function filterCities() {
                    var input, filter, ul, li, span, i, txtValue;
                    var foundCount = 0;

                    input = document.getElementById('LocationName');
                    filter = input.value.toUpperCase();
                    ul = document.getElementById("cityList");
                    li = ul.getElementsByTagName('li');
                    var noMsg = document.getElementById("noCityMsg");

                    for (i = 0; i < li.length; i++) {
                        span = li[i].getElementsByClassName("cityName")[0];
                        if (span) {
                            txtValue = span.textContent || span.innerText;
                            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                                li[i].style.display = "";
                                foundCount++;
                            } else {
                                li[i].style.display = "none";
                            }
                        }
                    }

                    if (foundCount === 0) {
                        noMsg.style.display = "block";
                    } else {
                        noMsg.style.display = "none";
                    }
                }
            </script>

            <script type="text/javascript">
                function openLocationModal() {
                    // Alert first
                    alert("Please select your location first to search nearby food!");

                    // Open Bootstrap Modal
                    var myModal = new bootstrap.Modal(document.getElementById('SearchLocation'));
                    myModal.show();
                }
            </script>

            <a href="#" onclick="topFunction()" id="back-to-top" class="back-to-top fs-5"><i class="ri-arrow-up-s-fill align-middle"></i></a>

            <script src="assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
            <script src="assets/libs/tiny-slider/min/tiny-slider.js"></script>
            <script src="assets/js/plugins.init.js"></script>
            <script src="assets/js/app.js"></script>



            <script>
                // --- 1. GEOLOCATION LOGIC ---
                function getLocation(btnElement) {
                    if (navigator.geolocation) {
                        // Button ka text/style change karein taaki user wait kare
                        // Hum icon ko 'spin' class dete hain aur text change karte hain
                        var originalText = btnElement.innerHTML;
                        btnElement.innerHTML = '<i class="ri-loader-4-line ri-spin me-2"></i> Detecting...';
                        btnElement.disabled = true; // Button disable karein taaki double click na ho

                        navigator.geolocation.getCurrentPosition(
                            function (position) { showPosition(position, btnElement, originalText); },
                            function (error) { showError(error, btnElement, originalText); }
                        );
                    } else {
                        alert("Geolocation is not supported by this browser.");
                    }
                }

                function showPosition(position, btnElement, originalText) {
                    var lat = position.coords.latitude;
                    var long = position.coords.longitude;

                    // 1. Check karein ki user ne Header wale Search Box mein kuch likha hai ya nahi
                    var searchBox = document.getElementById('<%= txtGlobalSearch.ClientID %>');
                    var searchTerm = "";

                    if (searchBox) {
                        searchTerm = searchBox.value.trim();
                    }

                    // 2. Base URL banayein (Location ke saath)
                    // 'type=nearby' backend ko batayega ki distance calculate karna hai
                    var url = "Restaurants.aspx?type=nearby&lat=" + lat + "&lng=" + long;

                    // 3. Agar user ne kuch search kiya hai (e.g. Pizza), toh 'q' parameter add karein
                    // Agar khali hai, toh 'q' add nahi hoga, aur Backend saare restaurants dikhayega
                    if (searchTerm !== "") {
                        url += "&q=" + encodeURIComponent(searchTerm);
                    }

                    // 4. Redirect karein
                    window.location.href = url;
                }

                function showError(error, btnElement, originalText) {
                    switch (error.code) {
                        case error.PERMISSION_DENIED:
                            alert("User denied the request for Geolocation. Please enable location access.");
                            break;
                        case error.POSITION_UNAVAILABLE:
                            alert("Location information is unavailable.");
                            break;
                        case error.TIMEOUT:
                            alert("The request to get user location timed out.");
                            break;
                        case error.UNKNOWN_ERROR:
                            alert("An unknown error occurred.");
                            break;
                    }
                    // Button ko wapas normal karein agar error aaye
                    if (btnElement) {
                        btnElement.innerHTML = originalText;
                        btnElement.disabled = false;
                    }
                }

                // --- 2. EXISTING CITY SEARCH FILTER (Modal ke andar) ---
                function filterCities() {
                    var input, filter, ul, li, span, i, txtValue;
                    var foundCount = 0;

                    input = document.getElementById('LocationName');
                    filter = input.value.toUpperCase();
                    ul = document.getElementById("cityList");
                    li = ul.getElementsByTagName('li');
                    var noMsg = document.getElementById("noCityMsg");

                    for (i = 0; i < li.length; i++) {
                        // Repeater me <a> tag ke andar span class="cityName" hai
                        var a = li[i].getElementsByTagName("a")[0];
                        span = a.getElementsByClassName("cityName")[0];

                        if (span) {
                            txtValue = span.textContent || span.innerText;
                            if (txtValue.toUpperCase().indexOf(filter) > -1) {
                                li[i].style.display = "";
                                foundCount++;
                            } else {
                                li[i].style.display = "none";
                            }
                        }
                    }

                    if (foundCount === 0) {
                        noMsg.style.display = "block";
                    } else {
                        noMsg.style.display = "none";
                    }
                }

                // --- 3. SELECT CITY LOGIC (Clicking from list) ---
                function selectCity(cityId, cityName) {
                    // Global search box check karein
                    var searchBox = document.getElementById('<%= txtGlobalSearch.ClientID %>');
        var searchTerm = "";
        if (searchBox) {
            searchTerm = searchBox.value.trim();
        }

        var url = "Restaurants.aspx?cityid=" + encodeURIComponent(cityId) + "&cityname=" + encodeURIComponent(cityName);

        // Agar search term hai to saath le jao
        if (searchTerm !== "") {
            url += "&q=" + encodeURIComponent(searchTerm);
        }

        window.location.href = url;
    }
</script>


            <script>
                (function () {
                    var tb = document.getElementById('<%= txtGlobalSearch.ClientID %>');
                    var box = document.getElementById('searchSuggestions');
                    var timer = null;

                    if (!tb || !box) return;

                    function hideBox() {
                        box.style.display = "none";
                        box.innerHTML = "";
                    }

                    function renderItems(items) {
                        if (!items || items.length === 0) {
                            hideBox();
                            return;
                        }

                        box.innerHTML = "";
                        items.forEach(function (x) {
                            var a = document.createElement("a");
                            a.href = "javascript:void(0)";
                            a.className = "list-group-item list-group-item-action d-flex justify-content-between align-items-center";

                            // left text
                            var left = document.createElement("span");
                            left.textContent = x.text;

                            // right badge type
                            var badge = document.createElement("span");
                            badge.className = "badge bg-light text-dark border";
                            badge.textContent = x.type; // Cafe / Dish

                            a.appendChild(left);
                            a.appendChild(badge);

                            a.addEventListener("click", function () {
                                tb.value = x.text;
                                hideBox();
                                tb.focus();
                            });

                            box.appendChild(a);
                        });

                        box.style.display = "block";
                    }

                    async function fetchSuggestions(q) {
                        // cityid agar URL me hai to pass kar denge
                        var params = new URLSearchParams(window.location.search);
                        var cityid = params.get("cityid") || "";

                        var url = "SearchSuggestions.ashx?q=" + encodeURIComponent(q) + "&cityid=" + encodeURIComponent(cityid);

                        try {
                            const res = await fetch(url, { method: "GET" });
                            if (!res.ok) return [];
                            return await res.json();
                        } catch (e) {
                            return [];
                        }
                    }

                    tb.addEventListener("keyup", function (e) {
                        var q = tb.value.trim();

                        // very small input => hide
                        if (q.length < 1) { // 1 character se hi suggestions chahiye (P)
                            hideBox();
                            return;
                        }

                        clearTimeout(timer);
                        timer = setTimeout(async function () {
                            var data = await fetchSuggestions(q);
                            renderItems(data);
                        }, 150);
                    });

                    // click outside => close
                    document.addEventListener("click", function (e) {
                        if (e.target !== tb && !box.contains(e.target)) {
                            hideBox();
                        }
                    });

                    // ESC => close
                    tb.addEventListener("keydown", function (e) {
                        if (e.key === "Escape") hideBox();
                    });
                })();
</script>


        </div>
    </form>
</body>
</html>