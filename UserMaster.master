food delivery partners,
restaurant menu online,
best food in my city,
top rated restaurants,
foodstore india,
restaurants in rajasthan,
restaurants in ajmer,
restaurants in bhilwara
" />

<meta name="author" content="FoodStore" />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#cb4f24" />

<meta property="og:title" content="FoodStore – Discover Local Food & Restaurants" />
<meta property="og:description" content="Find top-rated restaurants, cafes & street food in your city. View menus, reviews & locations on FoodStore." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://www.foodstore.in/" />
<meta property="og:image" content="https://www.foodstore.in/assets/images/og-foodstore.jpg" />

