<%@ Master Language="C#" AutoEventWireup="true" CodeFile="AdminMaster.master.cs" Inherits="Admin_AdminMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>FoodStore Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --sidebar-width: 260px;
            /* Deep Blue Gradient (Same as before) */
            --admin-gradient: linear-gradient(180deg, #1e3c72 0%, #2a5298 100%);
            --sidebar-item-active: rgba(255, 255, 255, 0.2);
            --bg-color: #f3f6f9;
        }

        body { font-family: 'Poppins', sans-serif; background-color: var(--bg-color); overflow-x: hidden; }

        /* --- SIDEBAR --- */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0; left: 0;
            background: var(--admin-gradient);
            color: white;
            box-shadow: 4px 0 20px rgba(0,0,0,0.1);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            transition: 0.3s;
        }

        /* --- BRAND --- */
        .sidebar-brand {
            padding: 30px 25px;
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            letter-spacing: 0.5px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .sidebar-brand i { 
            font-size: 28px; margin-right: 12px; 
            background: rgba(255,255,255,0.2); 
            padding: 8px; border-radius: 10px;
        }

        /* --- MENU (HIDDEN SCROLLBAR) --- */
        .sidebar-menu { 
            padding: 20px 15px; 
            flex-grow: 1; 
            overflow-y: auto; 
            
            /* Hide Scrollbar for Chrome, Safari and Opera */
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
        .sidebar-menu::-webkit-scrollbar { display: none; }

        /* Menu Section Header */
        .menu-header {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.6);
            margin: 20px 15px 8px;
            font-weight: 600;
        }

        /* Links */
        .sidebar a, .btn-logout {
            display: flex;
            align-items: center;
            padding: 14px 18px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            border-radius: 12px;
            margin-bottom: 6px;
            transition: all 0.2s ease-in-out;
            font-size: 14px;
            font-weight: 500;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
        }

        .sidebar a i, .btn-logout i { 
            width: 25px; font-size: 18px; margin-right: 10px; text-align: center; 
            opacity: 0.8; transition: 0.2s;
        }

        /* Hover State */
        .sidebar a:hover, .btn-logout:hover {
            background-color: var(--sidebar-item-active);
            color: #fff;
            transform: translateX(3px);
        }
        .sidebar a:hover i { opacity: 1; transform: scale(1.1); }

        /* Badges */
        .badge-notify {
            background: #ff4757; color: white; font-size: 10px; padding: 4px 8px;
            border-radius: 20px; font-weight: 700; margin-left: auto;
            box-shadow: 0 2px 5px rgba(255, 71, 87, 0.4);
        }

        /* --- FOOTER --- */
        .sidebar-footer {
            padding: 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.15);
        }
        .btn-logout { color: #ff6b81 !important; font-weight: 600; }
        .btn-logout:hover { background: rgba(255, 107, 129, 0.15); color: #ff8797 !important; }

        /* --- CONTENT AREA --- */
        .content-area {
            margin-left: var(--sidebar-width);
            transition: 0.3s;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header */
        .header-panel {
            background: white;
            padding: 15px 30px;
            display: flex; justify-content: space-between; align-items: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            position: sticky; top: 0; z-index: 900;
        }

        .toggle-btn { font-size: 24px; cursor: pointer; display: none; color: #1e3c72; }

        .admin-profile { display: flex; align-items: center; gap: 15px; }
        .admin-avatar {
            width: 42px; height: 42px;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            color: white; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; box-shadow: 0 4px 10px rgba(30, 60, 114, 0.2);
        }

        .page-content { padding: 30px; }

        /* --- MOBILE --- */
        @media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.show { transform: translateX(0); }
            .content-area { margin-left: 0; }
            .toggle-btn { display: block; }
            .overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999; }
            .overlay.active { display: block; }
        }
        .sidebar a.active {
  background-color: rgba(255,255,255,0.22);
  color: #fff;
  font-weight: 600;
}
.sidebar a.active i { opacity: 1; }

    </style>

    <asp:ContentPlaceHolder id="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        
        <div class="overlay" onclick="toggleSidebar()"></div>

        <div class="sidebar" id="sidebar">
            
            <div class="sidebar-brand">
                <i class="fas fa-shield-alt"></i> 
                <div>FoodStore <br/><span style="font-size: 11px; opacity: 0.7; font-weight: 400; letter-spacing: 1px;">ADMIN PANEL</span></div>
            </div>
            
            <div class="sidebar-menu">
                
                <div class="menu-header">MAIN</div>
                <a href="Dashboard.aspx"><i class="fas fa-th-large"></i> Dashboard</a>
                
                <div class="menu-header">MANAGEMENT</div>
                <a href="AddCity.aspx"><i class="fas fa-map-marked-alt"></i> Cities</a>
                <a href="AddCategory.aspx"><i class="fas fa-layer-group"></i> Categories</a>
                
                <div class="menu-header">APPROVALS</div>
                <a href="PendingSellers.aspx">
                    <i class="fas fa-user-plus"></i> Seller Requests 
                    <asp:Label ID="lblSellerCount" runat="server" CssClass="badge-notify" Visible="false"></asp:Label>
                </a>
                <a href="PendingRestaurants.aspx">
                    <i class="fas fa-store"></i> Restaurants Request
                    <asp:Label ID="lblRestCount" runat="server" CssClass="badge-notify" Visible="false"></asp:Label>
                </a>

                <div class="menu-header">SYSTEM</div>
                <a href="AllRestaurants.aspx"><i class="fas fa-database"></i> All Restaurant</a>
                <a href="managereviews.aspx"><i class="fas fa-star-half-alt"></i> Reviews</a>
                <a href="viewreports.aspx"><i class="fas fa-flag"></i> Reports</a>
                <a href="viewqueries.aspx"><i class="fas fa-envelope-open"></i> Inbox</a>

            </div>

            <div class="sidebar-footer">
                <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="btn-logout">
                    <i class="fas fa-power-off"></i> Logout
                </asp:LinkButton>
            </div>
        </div>

        <div class="content-area">
            
            <div class="header-panel">
                <div class="d-flex align-items-center">
                    <span class="toggle-btn me-3" onclick="toggleSidebar()"><i class="fas fa-bars"></i></span>
                    <h5 class="mb-0 fw-bold text-dark" style="letter-spacing: -0.5px;">Dashboard</h5>
                </div>

                <div class="admin-profile">
                    <div class="text-end d-none d-sm-block">
                        <small class="text-muted d-block" style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">Admin</small>
                        <asp:Label ID="lblAdminName" runat="server" Text="Administrator" CssClass="fw-bold text-dark" style="font-size: 14px;"></asp:Label>
                    </div>
                    <div class="admin-avatar">
                        <i class="fas fa-user-tie"></i>
                    </div>
                </div>
            </div>

            <div class="page-content">
                <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>

        </div>

    </form>

    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('show');
            document.querySelector('.overlay').classList.toggle('active');
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>