<%@ Master Language="C#" AutoEventWireup="true" CodeFile="SellerMaster.master.cs" Inherits="seller_SellerMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>Seller Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-bg: #d32f2f; /* RED BACKGROUND */
            --sidebar-text: #ffffff; /* WHITE TEXT */
            --sidebar-hover: rgba(255, 255, 255, 0.15); /* Glassy Hover Effect */
            --bg-color: #f8f9fa;
        }

        body { font-family: 'Poppins', sans-serif; background-color: var(--bg-color); overflow-x: hidden; }

        /* --- SIDEBAR (RED THEME) --- */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0; left: 0;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-text);
            box-shadow: 4px 0 10px rgba(0,0,0,0.1);
            transition: 0.3s;
            z-index: 1000;
            display: flex;
            flex-direction: column;
        }

        /* Brand */
        .sidebar-brand {
            padding: 25px;
            font-size: 22px;
            font-weight: 700;
            color: #ffffff; /* White Brand */
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1); /* Light Border */
        }
        .sidebar-brand i { color: #ffffff; margin-right: 10px; font-size: 26px; }

        /* Menu */
        .sidebar-menu { padding: 20px 15px; flex-grow: 1; overflow-y: auto; }
        
        .menu-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.6); /* Dim White Label */
            margin: 15px 10px 5px;
            font-weight: 600;
        }

        .sidebar a, .btn-logout {
            display: flex;
            align-items: center;
            padding: 12px 18px;
            color: rgba(255, 255, 255, 0.9); /* Off-White Links */
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: 0.3s;
            font-size: 14px;
            font-weight: 500;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }

        .sidebar a i, .btn-logout i { width: 30px; font-size: 18px; color: #ffffff; transition: 0.3s; }

        /* Hover State - Glassy White */
        .sidebar a:hover, .btn-logout:hover {
            background-color: var(--sidebar-hover);
            color: #ffffff;
            padding-left: 22px; /* Slight slide effect */
        }

        /* Active State */
        .sidebar a.active-link {
            background-color: #ffffff;
            color: #d32f2f; /* Red Text on White */
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            font-weight: 700;
        }
        .sidebar a.active-link i { color: #d32f2f; }

        /* --- MAIN CONTENT --- */
        .main-content {
            margin-left: var(--sidebar-width);
            transition: 0.3s;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header */
        .top-header {
            background: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .toggle-btn { font-size: 24px; cursor: pointer; display: none; color: #333; }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }
      
        .user-avatar {
            width: 38px; height: 38px;
            background: #ffebee;
            color: #d32f2f;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; 
            font-size: 18px;  
            text-transform: uppercase; 
            border: 2px solid #ffcdd2; 
        }

        /* Page Content Padding */
        .page-content { padding: 30px; }

        /* --- MOBILE RESPONSIVE --- */
        @media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-left: 0; }
            .toggle-btn { display: block; }
            .overlay {
                display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
                background: rgba(0,0,0,0.5); z-index: 999;
            }
            .overlay.active { display: block; }
        }
    </style>
    
    <asp:ContentPlaceHolder id="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        
        <div class="overlay" onclick="toggleMenu()"></div>

        <div class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <i class="fas fa-utensils"></i> Partner Panel
            </div>

            <div class="sidebar-menu">
                <div class="menu-label">Main</div>
                <a href="Dashboard.aspx"><i class="fas fa-home"></i> Dashboard</a>
                <a href="LeadHistory.aspx"><i class="fas fa-phone-volume"></i> Call History</a>

                <div class="menu-label">Restaurant</div>
                <a href="AddRestaurant.aspx"><i class="fas fa-plus-circle"></i> Add Restaurant</a>
                <a href="MyRestaurants.aspx"><i class="fas fa-store"></i> My Restaurants</a>
                
                <div class="menu-label">Settings</div>
                <a href="Profile.aspx"><i class="fas fa-user-cog"></i> Profile</a>
                
                <div class="mt-3 border-top pt-2" style="border-color: rgba(255,255,255,0.1) !important;">
                    <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="btn-logout">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </asp:LinkButton>
                </div>
            </div>
        </div>

        <div class="main-content">
            
            <div class="top-header">
                <div class="d-flex align-items-center">
                    <i class="fas fa-bars toggle-btn me-3" onclick="toggleMenu()"></i>
                    <h5 class="mb-0 fw-bold text-dark">Dashboard</h5>
                </div>

                <div class="user-profile">
                    <div class="text-end d-none d-sm-block">
                        <small class="text-muted d-block" style="font-size: 11px;">Signed in as</small>
                        <asp:Label ID="lblSellerName" runat="server" Text="Seller" CssClass="fw-bold text-dark" style="font-size: 14px;"></asp:Label>
                    </div>
                    <div class="user-avatar">
                        <asp:Label ID="lblProfileLetter" runat="server" Text="U"></asp:Label>
                    </div>
                </div>
            </div>

            <div class="page-content">
                <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>

        </div>

    </form>

    <script>
        function toggleMenu() {
            document.getElementById('sidebar').classList.toggle('show');
            document.querySelector('.overlay').classList.toggle('active');
        }

        // Script to Highlight Active Menu
        document.addEventListener("DOMContentLoaded", function () {
            var currentLocation = window.location.pathname.split("/").pop();
            var menuItems = document.querySelectorAll('.sidebar a');
            menuItems.forEach(function (item) {
                if (item.getAttribute("href") === currentLocation) {
                    item.classList.add("active-link");
                }
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>